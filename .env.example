# =============================================
# OWNSPACE ENVIRONMENT VARIABLES
# =============================================
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local or any real secrets.
#
# Where to find each value:
#   Supabase Dashboard -> Project Settings -> API
#
# Project URL (public)
NEXT_PUBLIC_SUPABASE_URL=
#
# Public anon key (public, safe for the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
#
# Service role key (SECRET. Server-only. Never use in client code.)
SUPABASE_SERVICE_ROLE_KEY=

# Direct Postgres connection, used by `npm run db:migrate` and `npm run db:verify`.
SUPABASE_DB_URL=

# =============================================
# GOOGLE DRIVE (optional)
# =============================================
# Without these the /gdrive page renders a "not configured" notice and every
# other Drive surface stays inert.
#
# Where to find each value:
#   Google Cloud Console -> a project -> APIs & Services -> Credentials
#   -> OAuth client ID -> "Web application"
#
# Authorised redirect URI (must match exactly):
#   http://localhost:3000/auth/gdrive/callback
#   https://your-domain.com/auth/gdrive/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=